<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="com.biglinux.Iris" path="/com/biglinux/Iris/">

    <key name="window-width" type="i">
      <default>1280</default>
      <summary>Default window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>800</default>
      <summary>Default window height</summary>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Window maximized</summary>
    </key>

    <key name="autohide-ui" type="b">
      <default>true</default>
      <summary>Hide the UI automatically when idle, like a video player</summary>
    </key>
    <key name="autohide-delay-ms" type="u">
      <default>1500</default>
      <range min="500" max="10000"/>
      <summary>Time (ms) without user activity before the UI hides</summary>
    </key>

    <key name="filmstrip-visible" type="b">
      <default>true</default>
      <summary>Show the thumbnail strip at the bottom</summary>
    </key>

    <key name="slideshow-interval-s" type="u">
      <default>5</default>
      <range min="1" max="3600"/>
      <summary>Slideshow interval in seconds</summary>
    </key>

  </schema>
</schemalist>
