msgid "expected W:H (e.g. 1:1, 9:16), got: {value}"
msgstr "W:H bekleniyordu (ör. 1:1, 9:16), alınan: {value}"

#: crates/bigiris/src/main.rs:335
msgid "invalid W ratio: {error}"
msgstr "geçersiz W oranı: {error}"

#: crates/bigiris/src/main.rs:337
msgid "invalid H ratio: {error}"
msgstr "geçersiz H oranı: {error}"

