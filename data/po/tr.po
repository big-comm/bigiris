msgid "Encoder speed 1..30 (higher = faster, worse palette)"
msgstr "Kodlayıcı hızı 1..30 (yüksek = daha hızlı, daha kötü palet)"

#: crates/bigiris/src/main.rs:713
msgid "Frames in order (at least 1)"
msgstr "Sıralı kareler (en az 1)"

