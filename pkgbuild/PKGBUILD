# Maintainer: Leonardo Athayde <leoathayde@gmail.com>
# Contributor: Bruno Goncalves <bigbruno@gmail.com>

pkgname=bigiris
pkgdesc="Modern image viewer and converter with file manager integration"
depends=(
  'bubblewrap'
  'util-linux'
  'gcc-libs'
  'glibc'
  'gtk4>=4.12'
  'libadwaita>=1.5'
  'dav1d'            # AVIF decoder
  'openssl'          # TLS for AI model downloads (ureq + native-tls)
  'onnxruntime'      # AI backend (BiRefNet), loaded dynamically
  'hicolor-icon-theme'
)
optdepends=(
  'nautilus-python: Nautilus context menu integration'
  'dolphin: Dolphin file manager integration (KDE)'
  'nautilus: Nautilus file manager integration (GNOME)'
  'nemo: Nemo file manager integration (Cinnamon)'
  'thunar: Thunar file manager integration (XFCE)'
  'pcmanfm-qt: PCManFM-Qt file manager integration (LXQt)'
  'io.elementary.files: Files file manager integration (elementary)'
)
makedepends=('rust' 'cargo' 'git' 'pkgconf' 'gettext' 'python')
# Disable LTO. Arch's default makepkg env appends `-flto=auto` to CFLAGS
# and `-C linker-plugin-lto` to RUSTFLAGS, which makes cc-rs emit pure
# LTO bitcode for libmimalloc-sys's static.o. Without an LLVM gold/LTO
# plugin loaded into the linker (bfd or rust-lld), every `mi_*` symbol
# shows up undefined at the final link. Confirmed against the leaner
# archlinux:latest CI image; some user setups can hit it too. We keep
# -O3 and the mimalloc batch perf win without LTO.
options=('!lto')
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
arch=('x86_64')
license=('GPL-3.0-or-later')
url="https://github.com/big-comm/${pkgname}"
source=("git+${url}.git")
sha256sums=('SKIP')

# Automatically detect and use the correct install file.
if [ -f "${pkgname}.install" ]; then
  install="${pkgname}.install"
elif [ -f "pkgbuild.install" ]; then
  install="pkgbuild.install"
fi

prepare() {
  cd "${srcdir}/${pkgname}"
  # Add blueprint-compiler when the GUI starts using .blp files.
  true
}

build() {
  cd "${srcdir}/${pkgname}"
  python3 scripts/translations.py check
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  # Build the GTK4/libadwaita viewer and AI dialogs in one binary.
  # Background removal uses BiRefNet; resize/upscale uses Lanczos3.
  # ONNX Runtime is loaded dynamically at runtime.
  cargo build --locked --release --features "gui ai" --package bigiris

  # Compile every translation catalog listed in data/po/LINGUAS.
  # package() installs the resulting .mo files under /usr/share/locale.
  while read -r lang; do
    [[ -z "$lang" || "$lang" == \#* ]] && continue
    msgfmt --check -o "data/po/${lang}.mo" "data/po/${lang}.po"
  done < data/po/LINGUAS
}

check() {
  cd "${srcdir}/${pkgname}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  bash scripts/package-check.sh "$CARGO_TARGET_DIR"
}

package() {
  cd "${srcdir}/${pkgname}"

  # Binary
  install -Dm755 "$srcdir/target/release/bigiris" \
    "$pkgdir/usr/bin/bigiris"

  # Reverse-DNS identifiers shared by the desktop, AppStream and icon.
  install -Dm644 "data/com.biglinux.Iris.desktop" \
    "$pkgdir/usr/share/applications/com.biglinux.Iris.desktop"
  install -Dm644 "data/com.biglinux.Iris.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/com.biglinux.Iris.metainfo.xml"
  install -Dm644 "data/com.biglinux.Iris.gschema.xml" \
    "$pkgdir/usr/share/glib-2.0/schemas/com.biglinux.Iris.gschema.xml"
  install -Dm644 "data/icons/hicolor/scalable/apps/com.biglinux.Iris.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/com.biglinux.Iris.svg"

  # Documentation and license
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

  # Translation catalogs compiled in build().
  while read -r lang; do
    [[ -z "$lang" || "$lang" == \#* ]] && continue
    install -Dm644 "data/po/${lang}.mo" \
      "$pkgdir/usr/share/locale/${lang}/LC_MESSAGES/$pkgname.mo"
  done < data/po/LINGUAS

  # Install file-manager integrations into the package staging directory.
  # The package provides the system-wide files; users do not need
  # to register a second personal copy of the integrations.
  # Nautilus requires the optional nautilus-python package.
  "$srcdir/target/release/bigiris" install-integrations --system \
    --destdir="$pkgdir"
}
