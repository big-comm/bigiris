_refresh_caches() {
  glib-compile-schemas /usr/share/glib-2.0/schemas/ &>/dev/null || true
  update-desktop-database -q /usr/share/applications &>/dev/null || true
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor &>/dev/null || true
  update-mime-database /usr/share/mime &>/dev/null || true
  # Dolphin / KIO cache — only present on KDE systems
  if command -v kbuildsycoca6 &>/dev/null; then
    kbuildsycoca6 --noincremental &>/dev/null || true
  elif command -v kbuildsycoca5 &>/dev/null; then
    kbuildsycoca5 --noincremental &>/dev/null || true
  fi
}

# Thunar keeps custom actions in /etc/xdg/Thunar/uca.xml, a file owned by
# the thunar package, so BigIris no longer ships Thunar actions system-wide.
# Each user merges them into ~/.config/Thunar/uca.xml instead.
_thunar_hint() {
  command -v thunar &>/dev/null || return 0
  echo '==> Thunar: run "bigiris install-integrations --user" as your user'
  echo '    to add the BigIris actions to the Thunar context menu. It only'
  echo '    writes ~/.config/Thunar/uca.xml; the other file managers use the'
  echo '    copies this package installs in /usr/share.'
  # Older BigIris packages owned /etc/xdg/Thunar/uca.xml (only possible with
  # a forced install over thunar); removing that package drops the file.
  if [ ! -e /etc/xdg/Thunar/uca.xml ] && pacman -Qq thunar &>/dev/null; then
    echo '==> /etc/xdg/Thunar/uca.xml is missing: reinstall thunar'
    echo '    (pacman -S thunar) to restore its default custom actions.'
  fi
}

post_install() {
  _refresh_caches
  _thunar_hint
}

post_upgrade() {
  _refresh_caches
  _thunar_hint
}

post_remove() {
  _refresh_caches
}
