#: crates/bigiris/src/main.rs:411
msgid ""
"Visual quality to aim for: maximum, balanced or smallest (also max, small). "
"Each format looks for the smallest file that keeps this quality (SSIMULACRA2 "
"85 / 80 / 70)"
msgstr ""
"Qualité visuelle visée : maximum, balanced ou smallest (ou max, small). "
"Chaque format cherche le plus petit fichier qui conserve cette qualité "
"(SSIMULACRA2 85 / 80 / 70)"

#: crates/bigiris/src/main.rs:417
msgid ""
"Fixed quality 1..100 for JPEG/WebP/AVIF, without searching (ignores --"
"target). In WebP, 100 writes losslessly"
msgstr ""
"Qualité fixe 1..100 pour JPEG/WebP/AVIF, sans recherche (ignore --target). "
"En WebP, 100 enregistre sans perte"

#: crates/bigiris/src/main.rs:420
msgid "Accepted for compatibility: JPEG is always progressive"
msgstr "Accepté pour compatibilité : le JPEG est déjà toujours progressif"

#: crates/bigiris/src/main.rs:422
msgid "Slower compression and smaller files, with no extra loss: PNG and AVIF"
msgstr ""
"Compression plus lente et plus compacte, sans perte supplémentaire : PNG et "
"AVIF"

#: crates/bigiris/src/main.rs:435
msgid "Convert files (headless)"
msgstr "Convertir des fichiers (sans interface graphique)"

#: crates/bigiris/src/main.rs:439
msgid ""
"Target format: png, jpg, webp, avif, tiff, bmp, gif, ico, pnm/ppm/pgm/pbm, "
"tga, qoi, hdr, exr"
msgstr ""
"Format de destination : png, jpg, webp, avif, tiff, bmp, gif, ico, pnm/ppm/"
"pgm/pbm, tga, qoi, hdr, exr"

#: crates/bigiris/src/main.rs:448 crates/bigiris/src/main.rs:466
#: crates/bigiris/src/main.rs:491 crates/bigiris/src/main.rs:518
msgid "What to do when the output file already exists"
msgstr "Politique lorsque le fichier de sortie existe déjà"

#: crates/bigiris/src/main.rs:454
msgid ""
"Write each output over its own input; an input whose output would be another "
"file is refused"
msgstr ""

#: crates/bigiris/src/main.rs:457 crates/bigiris/src/main.rs:469
msgid "Input files"
msgstr "Fichiers d’entrée"

#: crates/bigiris/src/main.rs:460
msgid ""
"Remove the metadata (EXIF, IPTC, XMP, comments) of each file by re-encoding "
"it in its own format (headless)"
msgstr ""

#: crates/bigiris/src/main.rs:472
msgid ""
"Resize files (headless). Exactly one mode among --max-edge / --percent / --"
"exact / --fit is required"
msgstr ""
"Redimensionner des fichiers (sans interface graphique). Un seul mode parmi --"
"max-edge / --percent / --exact / --fit est obligatoire"

#: crates/bigiris/src/main.rs:480
msgid "Interpolation kernel (default: lanczos3)"
msgstr "Noyau d’interpolation (par défaut : lanczos3)"

#: crates/bigiris/src/main.rs:483 crates/bigiris/src/main.rs:512
msgid "Target format (optional; keeps the original format if omitted)"
msgstr ""
"Format de destination (facultatif ; conserve le format d’origine s’il est "
"omis)"

#: crates/bigiris/src/main.rs:497
msgid ""
"Rotate files (headless). Right-angle rotations through a re-encode pipeline; "
"`--auto` reads the EXIF Orientation tag and applies the right rotation"
msgstr ""
"Faire pivoter des fichiers (sans interface graphique). Rotations cardinales "
"par réencodage ; `--auto` lit la balise EXIF Orientation et applique la "
"bonne rotation"

#: crates/bigiris/src/main.rs:503
msgid "Rotation in degrees: 90 | 180 | 270"
msgstr "Degrés cardinaux : 90 | 180 | 270"

#: crates/bigiris/src/main.rs:509
msgid "Auto-orient from EXIF (Orientation tag)"
msgstr "Orientation automatique via EXIF (balise Orientation)"

#: crates/bigiris/src/main.rs:524
msgid "Mirror files horizontally or vertically (headless)"
msgstr ""
"Retourner des fichiers horizontalement ou verticalement (sans interface "
"graphique)"

#: crates/bigiris/src/main.rs:526
msgid "Axis: horizontal | vertical"
msgstr "Axe : horizontal | vertical"

#: crates/bigiris/src/main.rs:528 crates/bigiris/src/main.rs:542
#: crates/bigiris/src/main.rs:566 crates/bigiris/src/main.rs:606
msgid "Target format (optional)"
msgstr "Format de destination (facultatif)"

#: crates/bigiris/src/main.rs:535
msgid ""
"Crop a rectangle from images (headless). Use --rect WxH+X+Y, ImageMagick "
"style"
msgstr ""
"Rogner un rectangle dans les images (sans interface graphique). Utilisez --"
"rect WxH+X+Y à la manière d’ImageMagick"

#: crates/bigiris/src/main.rs:539
msgid "Crop geometry in the WxH+X+Y format (e.g. 800x600+100+50)"
msgstr "Géométrie du rognage au format WxH+X+Y (ex. : 800x600+100+50)"

#: crates/bigiris/src/main.rs:549
msgid ""
"Extend the canvas around the image (letterbox). Exactly one mode among --"
"size and --aspect is required. The canvas is filled with --bg and the "
"original image is placed by --gravity"
msgstr ""
"Étendre le canevas autour de l’image (letterbox). Un seul mode parmi --size "
"et --aspect est obligatoire. Le canevas est rempli avec --bg et l’image "
"d’origine est placée selon --gravity"

#: crates/bigiris/src/main.rs:556
msgid "Background color in hexadecimal (#RRGGBB or #RRGGBBAA)"
msgstr "Couleur d’arrière-plan en hexadécimal (#RRGGBB ou #RRGGBBAA)"

#: crates/bigiris/src/main.rs:563
msgid "Position of the original image on the extended canvas"
msgstr "Position de l’image d’origine dans le canevas étendu"

#: crates/bigiris/src/main.rs:573
msgid "Adjust color/tone (brightness, contrast, saturation, gamma)"
msgstr "Ajuster couleur/tonalité (luminosité, contraste, saturation, gamma)"

#: crates/bigiris/src/main.rs:580
msgid "Brightness -100..100 (0 = no change)"
msgstr "Luminosité -100..100 (0 = sans changement)"

#: crates/bigiris/src/main.rs:588
msgid "Contrast -100..100 (0 = no change)"
msgstr "Contraste -100..100 (0 = sans changement)"

#: crates/bigiris/src/main.rs:596
msgid "Saturation -100..100 (-100 = gray, 0 = no change)"
msgstr "Saturation -100..100 (-100 = gris, 0 = sans changement)"

#: crates/bigiris/src/main.rs:603
msgid "Gamma 0.1..10.0 (< 1 brightens midtones, > 1 darkens)"
msgstr "Gamma 0.1..10.0 (< 1 éclaircit les tons moyens, > 1 assombrit)"

#: crates/bigiris/src/main.rs:613
msgid ""
"Remove the background with local AI (BiRefNet-lite, birefnet-native "
"package). Writes `<name>_nobg.png` (PNG with alpha) next to each image"
msgstr ""
"Supprimer l’arrière-plan avec l’IA locale (BiRefNet-lite, paquet birefnet-"
"native). Écrit `<nom>_nobg.png` (PNG avec alpha) à côté de chaque image"

#: crates/bigiris/src/main.rs:619
msgid "Segmentation model"
msgstr "Modèle de segmentation"

#: crates/bigiris/src/main.rs:626
msgid "What to do when `<name>_nobg.png` already exists"
msgstr "Politique lorsque `<nom>_nobg.png` existe déjà"

#: crates/bigiris/src/main.rs:632
msgid ""
"Increase resolution by 2, 3 or 4. With the realesrgan-native package it uses "
"AI (Real-ESRGAN); without it, Lanczos3. Writes `<name>_<pct>pct.<ext>`"
msgstr ""
"Augmenter la résolution par 2, 3 ou 4. Avec le paquet realesrgan-native, "
"utilise l’IA (Real-ESRGAN) ; sans lui, Lanczos3. Écrit `<nom>_<pct>pct.<ext>`"

#: crates/bigiris/src/main.rs:634
msgid "Integer factor (2, 3 or 4)"
msgstr "Facteur entier (2, 3 ou 4)"

#: crates/bigiris/src/main.rs:640
msgid ""
"Engine: auto (Real-ESRGAN if installed, otherwise Lanczos3), realesrgan "
"(fails if missing) or lanczos"
msgstr ""
"Moteur : auto (Real-ESRGAN s’il est installé, sinon Lanczos3), realesrgan "
"(échoue s’il est absent) ou lanczos"

#: crates/bigiris/src/main.rs:647 crates/bigiris/src/main.rs:659
#: crates/bigiris/src/main.rs:677 crates/bigiris/src/main.rs:710
msgid "Overwrite policy for the output file"
msgstr "Politique d’écrasement du fichier de sortie"

