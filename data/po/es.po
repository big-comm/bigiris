msgstr ""
"Esta compilación no incluye IA. Recompile con `cargo build --features ai` "
"(requiere glslc, del paquete shaderc)."

#: crates/bigiris/src/error_text.rs:128
msgid "{model} is not installed. Install it with: sudo pacman -S {package}"
msgstr "{model} no está instalado. Instálelo con: sudo pacman -S {package}"

